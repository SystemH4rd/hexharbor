{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HexHarbor live technical evidence report v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "inputType",
    "checkedAt",
    "mode",
    "status",
    "transport",
    "findings",
    "notices"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "version": {
      "type": "string"
    },
    "application": {
      "const": "HexHarbor"
    },
    "inputType": {
      "enum": [
        "phone",
        "email",
        "photo"
      ]
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "const": "live"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "error"
      ]
    },
    "transport": {
      "type": "string"
    },
    "subject": {
      "type": [
        "string",
        "null"
      ]
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "summary",
          "source",
          "sourceUrl",
          "observedAt",
          "fields"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "observed",
              "derived",
              "unknown",
              "error"
            ]
          },
          "summary": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "sourceUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "sourceVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "value"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "sensitive": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}

